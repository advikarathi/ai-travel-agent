# Copy this file to .env and paste your key. Never put a real key in this file:
# .env.example is meant to be committed to Git, .env is not.
# Any OpenAI-compatible chat API works. These settings use Google Gemini's free tier
# (get a key at https://aistudio.google.com).
LARK_LLM_API_KEY=
LARK_LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LARK_LLM_MODEL=gemini-3.8-flash
# Used automatically when the main model is busy (503), rate-limited (429) or unknown.
LARK_LLM_FALLBACK_MODEL=gemini-3.1-flash-lite
