# Copy this file to .streamlit/secrets.toml (or use .env) and paste your key.
# Lark needs an LLM. Any OpenAI-compatible chat API works.

LARK_LLM_API_KEY = ""

# Google Gemini free tier (key from https://aistudio.google.com)
LARK_LLM_BASE_URL = "https://generativelanguage.googleapis.com/v1beta/openai/"
LARK_LLM_MODEL = "gemini-3.8-flash"
# Used automatically when the main model is busy (503), rate-limited (429) or unknown.
LARK_LLM_FALLBACK_MODEL = "gemini-3.1-flash-lite"

# Other free options. Model names change often; check the provider's list.
# Groq:        LARK_LLM_BASE_URL = "https://api.groq.com/openai/v1"
#              LARK_LLM_MODEL    = "llama-3.3-70b-versatile"
# OpenRouter:  LARK_LLM_BASE_URL = "https://openrouter.ai/api/v1"
#              LARK_LLM_MODEL    = "<pick any model tagged :free on openrouter.ai/models>"
# Ollama:      LARK_LLM_BASE_URL = "http://localhost:11434/v1"   (key can be any text)
#              LARK_LLM_MODEL    = "llama3.1"
